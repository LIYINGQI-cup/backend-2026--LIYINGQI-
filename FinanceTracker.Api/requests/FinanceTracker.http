### 1. Login (returns token)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@fintracker.local",
  "password": "Demo12345"
}

### 2. Get current user
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{token}}

### 3. Update current user name
PUT {{baseUrl}}/api/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Demo User"
}

### 4. Get all accounts (check balances: Cash 12710.00, Debit card 48928.50, Savings 2055.00)
GET {{baseUrl}}/api/accounts
Authorization: Bearer {{token}}

### 5. Create an account
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Travel Fund",
  "currency": "EUR",
  "startAmount": 500
}

### 6. Get account by ID
GET {{baseUrl}}/api/accounts/c0000000-0000-0000-0000-000000000002
Authorization: Bearer {{token}}

### 7. Update account (name and startAmount)
PUT {{baseUrl}}/api/accounts/c0000000-0000-0000-0000-000000000002
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Debit card",
  "currency": "RUB",
  "startAmount": 42000.00
}

### 8. Archive an account
PATCH {{baseUrl}}/api/accounts/c0000000-0000-0000-0000-000000000002/archive
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isArchived": true
}

### 9. Delete an empty account (replace ID with a newly created one)
# DELETE {{baseUrl}}/api/accounts/{id}}
# Authorization: Bearer {{token}}

### 10. Get all categories
GET {{baseUrl}}/api/categories
Authorization: Bearer {{token}}

### 11. Create a category
POST {{baseUrl}}/api/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Books",
  "type": "Expense"
}

### 12. Rename a category
PUT {{baseUrl}}/api/categories/b0000000-0000-0000-0000-000000000001
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Food"
}

### 13. Delete a category
# DELETE {{baseUrl}}/api/categories/{id}}
# Authorization: Bearer {{token}}

### 14. Get operations (paged, sorted)
GET {{baseUrl}}/api/operations?page=1&pageSize=5&sortBy=dateDesc
Authorization: Bearer {{token}}

### 15. Create an operation
POST {{baseUrl}}/api/operations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "accountId": "c0000000-0000-0000-0000-000000000002",
  "categoryId": "b0000000-0000-0000-0000-000000000001",
  "type": "Expense",
  "amount": 1250.00,
  "date": "2026-10-05",
  "comment": "Groceries"
}

### 16. Get operation by ID
GET {{baseUrl}}/api/operations/d0000000-0000-0000-0000-000000000003
Authorization: Bearer {{token}}

