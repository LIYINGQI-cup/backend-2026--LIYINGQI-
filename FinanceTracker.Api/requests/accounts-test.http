### 1. Get all accounts (expect 200, check balances: Cash 12710.00, Debit card 48928.50, Savings 2055.00)
GET {{baseUrl}}/api/accounts
Authorization: Bearer {{token}}

### 2. Create a new account (expect 201)
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Travel Fund",
  "currency": "EUR",
  "startAmount": 500
}

### 3. Create with invalid currency (expect 400)
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Bad Account",
  "currency": "XYZ",
  "startAmount": 100
}

### 4. Delete an account with operations (expect 409, using seed Debit Card ID)
DELETE {{baseUrl}}/api/accounts/c0000000-0000-0000-0000-000000000002
Authorization: Bearer {{token}}

### 5. Update currency of account with operations (expect 409, R7)
PUT {{baseUrl}}/api/accounts/c0000000-0000-0000-0000-000000000002
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Debit card",
  "currency": "USD",
  "startAmount": 42000.00
}

### 6. Archive an account (expect 200 OK)
PATCH {{baseUrl}}/api/accounts/c0000000-0000-0000-0000-000000000002/archive
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isArchived": true
}

### 7. Delete an empty account (expect 204)
DELETE {{baseUrl}}/api/accounts/83e9620e-dec9-4e21-9423-3d442b3b1313
Authorization: Bearer {{token}}